# 110M proxy sweep at the 1.3B rank / width (ranks 192 of width 768 = 0.25, like ranks 512 at 1.3B), no momentum, fused update,
# int8 forward. 110M ranks 256 / 128 reproduce the 1.3B curve shape vs master + extras (docs/figures/proxy_shape.png).
# Reference: master + extras 110M (mx_extras_s0 / _seed2, 2.7166 fixed). Base run first.
# + the schedule arms at ranks 512 (110M ranks 512 reproduces 1.3B ranks 512's curve shape incl. the late recovery)
sw192_base
sw192_th1020 --ts_theta_sched 10:20
sw192_th1218 --ts_theta_sched 12:18
sw192_tauanneal --ts_tau_anneal
sw192_p1 --ts_anneal 1.0
sw512_base --lowrank 512 --ts_rank_s 512
sw512_th1020 --lowrank 512 --ts_rank_s 512 --ts_theta_sched 10:20
sw512_th1218 --lowrank 512 --ts_rank_s 512 --ts_theta_sched 12:18
sw512_tauanneal --lowrank 512 --ts_rank_s 512 --ts_tau_anneal
sw512_p1 --lowrank 512 --ts_rank_s 512 --ts_anneal 1.0
sw512_p025 --lowrank 512 --ts_rank_s 512 --ts_anneal 0.25
sw512_p075 --lowrank 512 --ts_rank_s 512 --ts_anneal 0.75
sw512_tau2000 --lowrank 512 --ts_rank_s 512 --ts_tau 2000
sw192_lr1e3 --lr 1e-3 --min_lr 1e-4
sw192_lr2e3 --lr 2e-3 --min_lr 2e-4
sw192_lr3e3 --lr 3e-3 --min_lr 3e-4
sw192_spend050 --ts_spend 0.5
sw192_spend075 --ts_spend 0.75
sw192_spend125 --ts_spend 1.25
sw192_spend150 --ts_spend 1.5
sw192_b2_090 --ts_b2 0.9
sw192_b2_099 --ts_b2 0.99
sw192_wd0 --weight_decay 0.0
sw192_wd03 --weight_decay 0.3
sw192_warm100 --warmup 100
sw192_warm1000 --warmup 1000
sw192_bs8 --batch_size 8 --steps 18310 --warmup 610 --ts_tau 2000
sw192_bs32 --batch_size 32 --steps 4578 --warmup 153 --ts_tau 500
sw192_theta12 --ts_theta 12
sw192_theta20 --ts_theta 20
sw192_tau2000 --ts_tau 2000
sw192_p025 --ts_anneal 0.25
sw192_p075 --ts_anneal 0.75
sw192_b2_0999 --ts_b2 0.999
sw192_wd003 --weight_decay 0.03
